# OLAV v2.0 Development Configuration
# For local development/testing, set these optional values

# OpenAI API Configuration (required for full LLM functionality)
OPENAI_API_KEY=sk-your-key-here

# Optional: Use different model for testing
OLAV_LLM_MODEL=gpt-4-turbo-preview
OLAV_LLM_TEMPERATURE=0.1

# Optional: Network device credentials (for CLI execution tests)
NETWORK_USERNAME=admin
NETWORK_PASSWORD=password
NETWORK_TIMEOUT=60

# Optional: Database paths (defaults to .olav/databases/)
# OLAV_DB_MAIN=/path/to/main.duckdb
# OLAV_DB_AGENT=/path/to/agent.duckdb
# OLAV_DB_CACHE=/path/to/llm_cache.db

# Logging level for development
LOG_LEVEL=INFO
