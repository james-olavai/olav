{
  "shared": {
    "api_key": "YOUR_API_KEY_HERE"
  },
  "llm": {
    "provider": "openai",
    "model": "gpt-4o",
    "temperature": 0.1
  },
  "embedding": {
    "mode": "api",
    "api": {
      "model": "openai/text-embedding-3-small"
    },
    "fallback": {
      "enabled": true
    }
  },
  "auth": {
    "mode": "none"
  },
  "memory": {
    "reflection_ttl_days": 30,
    "dedup_threshold": 0.92,
    "fts_rebuild_every": 20,
    "cache_ttl_hours": 24,
    "cache_max_entries": 500
  }
}
