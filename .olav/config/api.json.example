{
  "_doc": "REQUIRED blocks: shared (or llm.api_key) + llm. All other blocks are OPTIONAL — omit them to use built-in defaults (olav.core.defaults). A minimal working config is just shared + llm. active_workspace is set by `olav workspace use`, not by hand.",
  "shared": {
    "api_key": "YOUR_API_KEY_HERE"
  },
  "llm": {
    "provider": "openai",
    "model": "gpt-4o",
    "temperature": 0.1,
    "_timeout_doc": "Per-request LLM timeout in seconds (default 60). Raise for slow SELF-HOSTED models — a large local llama.cpp/Ollama/vLLM model (e.g. gemma4-31b) can take >60s per turn as context grows, and the abort is otherwise misreported as an unreachable endpoint. 300-600 is a safe headroom for local; leave at 60 for cloud APIs.",
    "timeout": 60
  },
  "_batfish_doc": "OPTIONAL. Where the netops simulator finds Batfish (config-layer validation). Omit to use localhost:9996. Set host/port to point at a remote Batfish API, or start a local one: docker run -d -p 9996:9996 -p 9997:9997 batfish/allinone. Env OLAV_BATFISH_HOST/OLAV_BATFISH_HTTP_PORT override this.",
  "batfish": {
    "host": "localhost",
    "port": 9996,
    "ssl": false
  },
  "active_workspace": "core",
  "syslog_receiver": {
    "enabled": false,
    "port": 15514,
    "host": "0.0.0.0",
    "batch_size": 75,
    "flush_interval": 120,
    "parquet_compression": "snappy",
    "retention_days": 30,
    "auto_start": false
  },
  "embedding": {
    "mode": "api",
    "api": {
      "model": "openai/text-embedding-3-small"
    },
    "fallback": {
      "enabled": true
    },
    "max_input_chars": 6000,
    "reranker_timeout": 15.0
  },
  "auth": {
    "mode": "none"
  },
  "memory": {
    "reflection_ttl_days": 30,
    "dedup_threshold": 0.92,
    "fts_rebuild_every": 20,
    "cache_ttl_hours": 24,
    "cache_max_entries": 500,
    "recall_top_k": 3,
    "capture_max_items": 3,
    "decay_half_life_days": 60,
    "decay_weight_floor": 0.1
  },
  "services": {
    "jwt_login_timeout": 15.0,
    "schema_probe_timeout": 10.0,
    "schema_fetch_max_retries": 1,
    "api_registry_timeout": 30.0,
    "health_check_timeout": 30,
    "service_register_retries": 3,
    "service_register_retry_delay": 5.0,
    "syslog_port": 5514
  },
  "execution": {
    "max_skill_timeout_seconds": 600,
    "default_shell_timeout_seconds": 300,
    "max_skill_output_bytes": 524288
  },
  "agent": {
    "rubric_max_iterations": 2
  }
}
