{
  "$schema": "./schemas/paths.json",
  "description": "Path Configuration - All paths relative to project root",
  "notes": [
    "All paths are relative to project root (where OLAV.py or pyproject.toml lives)",
    "Environment variables override JSON values (prefix: OLAV_PATH_)",
    "AGENT_DIR can be overridden via AGENT_DIR env var"
  ],
  "agent_dir": ".olav",
  "databases_dir": ".olav/databases",
  "exports_dir": "exports",
  "reports_dir": "exports/reports",
  "logs_dir": ".olav/logs",
  "cache_dir": ".olav/cache",
  "skills_dir": ".olav/skills",
  "knowledge_dir": ".olav/knowledge",
  "templates_dir": ".olav/templates",
  "config_dir": ".olav/config",
  "tasks_dir": ".olav/tasks",
  "workflows_dir": ".olav/workflows",
  "nornir": {
    "hosts": ".olav/config/nornir/hosts.yaml",
    "groups": ".olav/config/nornir/groups.yaml",
    "defaults": ".olav/config/nornir/defaults.yaml"
  },
  "files": {
    "main_db": ".olav/databases/main.duckdb",
    "llm_cache": ".olav/databases/llm_cache.sqlite",
    "checkpoint": ".olav/databases/checkpoints.sqlite",
    "settings": ".olav/config/settings.json",
    "tasks_config": ".olav/config/tasks.json"
  }
}