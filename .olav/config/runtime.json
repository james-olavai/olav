{
  "$schema": "./schemas/runtime.json",
  "description": "Runtime Configuration - Execution, logging, and behavior settings",
  "notes": [
    "Environment variables override JSON values (prefix: OLAV_RUNTIME_)",
    "These are runtime behavior settings, not LLM or path configs"
  ],
  "execution": {
    "use_textfsm": true,
    "textfsm_fallback_to_raw": true,
    "enable_token_statistics": true,
    "timeout": 30,
    "query_timeout": 30,
    "concurrency": 10,
    "global_delay_factor": 4,
    "max_loops": 1000,
    "scrapli_timeout_ops": 300
  },
  "logging": {
    "level": "INFO",
    "format": "text",
    "display_thinking": false,
    "debug": false,
    "langsmith": {
      "enabled": false,
      "api_key": "",
      "project": "olav-v2"
    }
  },
  "cli": {
    "banner": "default",
    "show_banner": true,
    "default_host": "127.0.0.1",
    "default_port": 8000
  },
  "network": {
    "default_group": "test",
    "ssh_port": 22,
    "timeout": 60
  },
  "permissions": {
    "require_hitl_for_write": true,
    "require_hitl_for_delete": true,
    "audit_log_enabled": true
  },
  "sync": {
    "command_mode": "hybrid",
    "whitelist_file": ".olav/config/command_whitelist.yaml",
    "command_mode_config": ".olav/skills/guard/config/command_mode.yaml"
  }
}
