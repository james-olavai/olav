{
  "cache": {
    "enabled": true,
    "ttl_seconds": 3600,
    "max_size_mb": 1024,
    "cleanup_interval_hours": 24,
    "eviction_policy": "lru"
  },
  "backups": {
    "auto_enabled": true,
    "auto_interval_seconds": 86400,
    "retention_days": 30,
    "compression": true,
    "location": ".olav/backups"
  },
  "system_health": {
    "check_interval_seconds": 300,
    "cpu_warning_threshold_percent": 75,
    "cpu_critical_threshold_percent": 90,
    "memory_warning_threshold_percent": 80,
    "memory_critical_threshold_percent": 95,
    "disk_warning_threshold_percent": 85,
    "disk_critical_threshold_percent": 95
  },
  "permissions": {
    "require_hitl_for_write": true,
    "require_hitl_for_delete": true,
    "audit_log_enabled": true,
    "audit_location": ".olav/logs/system_audit.log"
  },
  "tasks": {
    "max_concurrent": 5,
    "default_timeout_seconds": 3600,
    "retry_attempts": 3,
    "retry_delay_seconds": 60
  },
  "database": {
    "optimization_enabled": true,
    "vacuum_interval_days": 7,
    "pragma_analysis_limit": 1000
  },
  "git_integration": {
    "enabled": true,
    "auto_commit": true,
    "commit_interval_hours": 1,
    "knowledge_path": ".olav/knowledge"
  }
}
