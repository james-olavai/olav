# Network Inspection Command Templates
# =====================================
# 定义不同场景的网络巡检命令集合
#
# 使用方法:
#   uv run python3 scripts/run_real_inspection.py --template basic
#   uv run python3 scripts/run_real_inspection.py --template full
#   uv run python3 scripts/run_real_inspection.py --template security

version: "2.0.0"
last_updated: "2026-02-17"

# 默认模板
default_template: "standard"

# ========================================================================
# Command Templates
# ========================================================================

templates:
  # 基础巡检 (7个命令，约2-3分钟)
  basic:
    description: "基础健康检查 - L1-L3层"
    estimated_time: "2-3 minutes"
    commands:
      - command: "show version"
        layer: "L1"
        category: "device-info"
        description: "设备版本和启动时间"
        parse: true
        
      - command: "show cpu"
        layer: "L1"
        category: "performance"
        description: "CPU利用率"
        parse: true
        
      - command: "show memory"
        layer: "L1"
        category: "performance"
        description: "内存利用率"
        parse: true
        
      - command: "show interfaces"
        layer: "L2"
        category: "connectivity"
        description: "接口状态和统计"
        parse: true
        
      - command: "show ip route"
        layer: "L3"
        category: "routing"
        description: "路由表"
        parse: true
        
      - command: "show ip ospf neighbor"
        layer: "L3"
        category: "routing"
        description: "OSPF邻居状态"
        parse: true
        
      - command: "show ip bgp summary"
        layer: "L3"
        category: "routing"
        description: "BGP会话摘要"
        parse: true

  # 标准巡检 (15个命令，约5-8分钟)
  standard:
    description: "标准健康检查 - L1-L4层 + 错误检测"
    estimated_time: "5-8 minutes"
    commands:
      # L1 - Physical Layer
      - command: "show version"
        layer: "L1"
        category: "device-info"
        
      - command: "show inventory"
        layer: "L1"
        category: "device-info"
        description: "硬件清单"
        
      - command: "show environment"
        layer: "L1"
        category: "environment"
        description: "环境状态（温度、风扇、电源）"
        
      - command: "show processes cpu"
        layer: "L1"
        category: "performance"
        description: "进程CPU详情"
        
      - command: "show processes memory"
        layer: "L1"
        category: "performance"
        description: "进程内存详情"
        
      # L2 - Data Link Layer
      - command: "show interfaces"
        layer: "L2"
        category: "connectivity"
        
      - command: "show interfaces status"
        layer: "L2"
        category: "connectivity"
        description: "接口状态汇总"
        
      - command: "show interfaces counters errors"
        layer: "L2"
        category: "errors"
        description: "接口错误统计"
        
      - command: "show cdp neighbors"
        layer: "L2"
        category: "topology"
        description: "CDP邻居发现"
        
      - command: "show lldp neighbors"
        layer: "L2"
        category: "topology"
        description: "LLDP邻居发现"
        
      # L3 - Network Layer
      - command: "show ip route"
        layer: "L3"
        category: "routing"
        
      - command: "show ip route summary"
        layer: "L3"
        category: "routing"
        description: "路由表统计"
        
      - command: "show ip ospf neighbor"
        layer: "L3"
        category: "routing"
        
      - command: "show ip bgp summary"
        layer: "L3"
        category: "routing"
        
      - command: "show ip arp"
        layer: "L3"
        category: "addressing"
        description: "ARP表"

  # 完整巡检 (30+个命令，约15-20分钟)
  full:
    description: "完整诊断 - L1-L7层全覆盖"
    estimated_time: "15-20 minutes"
    commands:
      # === L1 - Physical ===
      - command: "show version"
        layer: "L1"
        category: "device-info"
        
      - command: "show inventory"
        layer: "L1"
        category: "device-info"
        
      - command: "show environment all"
        layer: "L1"
        category: "environment"
        
      - command: "show tech-support"
        layer: "L1"
        category: "diagnostics"
        description: "完整技术支持信息（可能很慢）"
        timeout: 120
        
      - command: "show processes cpu history"
        layer: "L1"
        category: "performance"
        
      - command: "show processes memory sorted"
        layer: "L1"
        category: "performance"
        
      - command: "show boot"
        layer: "L1"
        category: "system"
        description: "启动配置"
        
      # === L2 - Data Link ===
      - command: "show interfaces"
        layer: "L2"
        category: "connectivity"
        
      - command: "show interfaces status"
        layer: "L2"
        category: "connectivity"
        
      - command: "show interfaces counters"
        layer: "L2"
        category: "traffic"
        
      - command: "show interfaces counters errors"
        layer: "L2"
        category: "errors"
        
      - command: "show interfaces trunk"
        layer: "L2"
        category: "connectivity"
        description: "Trunk接口状态"
        
      - command: "show mac address-table"
        layer: "L2"
        category: "switching"
        description: "MAC地址表"
        
      - command: "show spanning-tree summary"
        layer: "L2"
        category: "switching"
        description: "STP状态"
        
      - command: "show cdp neighbors detail"
        layer: "L2"
        category: "topology"
        
      - command: "show lldp neighbors detail"
        layer: "L2"
        category: "topology"
        
      # === L3 - Network ===
      - command: "show ip route"
        layer: "L3"
        category: "routing"
        
      - command: "show ip route summary"
        layer: "L3"
        category: "routing"
        
      - command: "show ip protocols"
        layer: "L3"
        category: "routing"
        description: "路由协议配置"
        
      - command: "show ip ospf"
        layer: "L3"
        category: "routing"
        
      - command: "show ip ospf neighbor"
        layer: "L3"
        category: "routing"
        
      - command: "show ip ospf interface"
        layer: "L3"
        category: "routing"
        
      - command: "show ip bgp summary"
        layer: "L3"
        category: "routing"
        
      - command: "show ip bgp"
        layer: "L3"
        category: "routing"
        description: "BGP路由表"
        
      - command: "show ip arp"
        layer: "L3"
        category: "addressing"
        
      - command: "show ip interface brief"
        layer: "L3"
        category: "addressing"
        
      # === L4 - Transport ===
      - command: "show tcp brief"
        layer: "L4"
        category: "transport"
        description: "TCP连接状态"
        
      - command: "show udp"
        layer: "L4"
        category: "transport"
        description: "UDP端口状态"
        
      # === L7 - Application ===
      - command: "show ip http server status"
        layer: "L7"
        category: "services"
        description: "HTTP服务状态"
        
      - command: "show ntp status"
        layer: "L7"
        category: "services"
        description: "NTP时钟同步"
        
      - command: "show logging"
        layer: "L7"
        category: "logging"
        description: "系统日志"

  # 安全审计模板
  security:
    description: "安全合规检查 - AAA、ACL、日志"
    estimated_time: "8-10 minutes"
    commands:
      - command: "show version"
        layer: "L1"
        category: "device-info"
        
      - command: "show users"
        layer: "L7"
        category: "security"
        description: "当前登录用户"
        
      - command: "show privilege"
        layer: "L7"
        category: "security"
        description: "当前权限级别"
        
      - command: "show aaa servers"
        layer: "L7"
        category: "security"
        description: "AAA服务器状态"
        
      - command: "show ip access-lists"
        layer: "L3"
        category: "security"
        description: "访问控制列表"
        
      - command: "show logging"
        layer: "L7"
        category: "security"
        description: "安全日志"
        
      - command: "show snmp"
        layer: "L7"
        category: "security"
        description: "SNMP配置"
        
      - command: "show crypto ipsec sa"
        layer: "L3"
        category: "security"
        description: "IPSec隧道状态"
        
      - command: "show ssh"
        layer: "L7"
        category: "security"
        description: "SSH会话"
        
      - command: "show running-config | include username"
        layer: "L7"
        category: "security"
        description: "用户账号配置"

  # 性能基准测试
  performance:
    description: "性能基准测试 - CPU、内存、流量"
    estimated_time: "3-5 minutes"
    commands:
      - command: "show processes cpu sorted"
        layer: "L1"
        category: "performance"
        
      - command: "show processes memory sorted"
        layer: "L1"
        category: "performance"
        
      - command: "show interfaces counters"
        layer: "L2"
        category: "performance"
        
      - command: "show interfaces counters errors"
        layer: "L2"
        category: "performance"
        
      - command: "show buffers"
        layer: "L1"
        category: "performance"
        description: "缓冲区使用情况"
        
      - command: "show platform hardware qfp active datapath utilization"
        layer: "L1"
        category: "performance"
        description: "数据平面性能（ASR/ISR）"
        optional: true

  # 快速健康检查 (5个命令，1分钟内)
  quick:
    description: "快速健康检查 - 核心指标"
    estimated_time: "< 1 minute"
    commands:
      - command: "show version"
        layer: "L1"
        category: "device-info"
        
      - command: "show processes cpu"
        layer: "L1"
        category: "performance"
        
      - command: "show interfaces status"
        layer: "L2"
        category: "connectivity"
        
      - command: "show ip ospf neighbor"
        layer: "L3"
        category: "routing"
        
      - command: "show ip bgp summary"
        layer: "L3"
        category: "routing"

# ========================================================================
# Layer Definitions
# ========================================================================

layers:
  L1:
    name: "Physical Layer"
    description: "设备硬件、性能、环境"
    
  L2:
    name: "Data Link Layer"
    description: "接口、交换、邻居发现"
    
  L3:
    name: "Network Layer"
    description: "路由、协议、IP地址"
    
  L4:
    name: "Transport Layer"
    description: "TCP/UDP连接"
    
  L7:
    name: "Application Layer"
    description: "服务、安全、管理"

# ========================================================================
# Category Definitions
# ========================================================================

categories:
  device-info: "设备信息"
  performance: "性能监控"
  environment: "环境监控"
  connectivity: "连接状态"
  errors: "错误统计"
  topology: "网络拓扑"
  routing: "路由协议"
  addressing: "地址管理"
  switching: "交换功能"
  transport: "传输层"
  security: "安全审计"
  services: "应用服务"
  logging: "日志审计"
  diagnostics: "诊断工具"
  traffic: "流量统计"
  system: "系统配置"
