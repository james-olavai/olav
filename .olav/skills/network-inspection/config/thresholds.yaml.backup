# Network Inspection Thresholds
# ================================
# 此文件由Agent首次运行时自动生成
# 用户可以手动修改阈值，Agent会自动应用
#
# 生成时间: 首次运行时自动创建
# 版本: 3.0.0

version: "3.0.0"
auto_generated: true
last_updated: null

# =========================================================================
# 全局默认策略
# =========================================================================
defaults:
  # 性能指标默认阈值（百分比）
  performance:
    warning: 70
    critical: 90
  
  # 错误计数默认阈值
  errors:
    warning: 1
    critical: 10
  
  # 计数变化容忍度
  count_tolerance:
    warning: 10  # 变化10%告警
    critical: 30  # 变化30%严重告警

# =========================================================================
# 检查项特定阈值（覆盖defaults）
# =========================================================================
inspection_items:
  # --- L1 - Physical Layer ---
  cpu_utilization:
    warning: 70
    critical: 90
    unit: percent
  
  memory_utilization:
    warning: 80
    critical: 95
    unit: percent
  
  environment:
    # 温度：默认从show environment自动解析
    temperature:
      warning: 60
      critical: 75
      unit: celsius
  
  # --- L2 - Data Link Layer ---
  interface_status:
    # 期望值检查
    expected:
      status: up
      protocol: up
  
  interface_errors:
    # 任何错误都告警
    in_errors:
      warning: 1
      critical: 10
    out_errors:
      warning: 1
      critical: 10
    crc_errors:
      warning: 0
      critical: 5
  
  # --- L3 - Network Layer ---
  ospf_neighbors:
    expected:
      state: "FULL"  # 支持 FULL/DR, FULL/BDR
  
  bgp_neighbors:
    expected:
      state: "Established"
  
  routing_table:
    # 路由数量变化检查
    count_change:
      warning: 10  # ±10% 告警
      critical: 30  # ±30% 严重

# =========================================================================
# 设备特定覆盖（可选）
# =========================================================================
# 示例：为特定设备设置不同阈值
# devices:
#   R1:
#     cpu_utilization:
#       warning: 60
#       critical: 80
#   CORE-01:
#     interface_errors:
#       in_errors:
#         warning: 10
#         critical: 50

devices: {}

# =========================================================================
# 维护窗口（告警抑制）
# =========================================================================
maintenance_windows: []
# 示例：
# - start: "2026-02-20T00:00:00"
#   end: "2026-02-20T04:00:00"
#   devices: [R1, R2]
#   reason: "Scheduled maintenance"
  known_anomalies: []
