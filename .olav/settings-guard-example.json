{
  "agent": {
    "enable_guard_routing": true,
    "guard_confidence_threshold": 0.85,
    "guard_cache_ttl": 3600,
    "guard_enable_multi_agent_detection": true,
    "guard_rules_file": "",
    
    "guard_rules_overrides": {
      "comment": "Customize Guard classification rules here. Leave empty to use SKILL.md defaults.",
      "comment2": "All patterns are treated as regex, case-insensitive.",
      "_note": "Examples below show how to add/modify patterns",
      
      "simple_indicators_custom": [
        "count|how many|多少|几个",
        "^(count|list|show|display|export|save)",
        "所有.*设备|all.*devices",
        "统计|statistics"
      ],
      
      "cli_indicators_custom": [
        "show.*command|执行命令",
        "实时|real-time|live|当前",
        "CPU|内存|流量|bandwidth"
      ],
      
      "dangerous_patterns_custom": [
        "delete.*all|删除.*所有",
        "drop.*database|执行.*代码",
        "泄露|泄露密码"
      ]
    }
  },
  
  "comment3": "To use custom rules:",
  "example1": "1. Uncomment and modify patterns above",
  "example2": "2. Or set via environment variable: OLAV_GUARD_RULES_FILE=/path/to/custom_rules.yaml",
  "example3": "3. Or place custom rules in separate YAML file and reference in guard_rules_file",
  
  "custom_rules_yaml_example": {
    "description": "Example of custom_rules.yaml format",
    "simple_indicators": [
      "count|how many",
      "list all",
      "show devices"
    ],
    "cli_indicators": [
      "show running-config",
      "get real-time data"
    ],
    "dangerous_patterns": [
      "delete database",
      "drop table"
    ]
  }
}
