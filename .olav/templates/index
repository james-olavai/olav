# TextFSM Template Index
# Format: Template, Hostname, Platform, Command
# 
# This file maps CLI commands to TextFSM templates
# Compatible with NTC-templates standard
#
# Template syntax: [[option]] means optional part
# Example: sh[[ow]] int[[erfaces]] matches "sh int", "show int", "show interfaces"

# Cisco IOS/IOS-XE Templates
cisco_ios_show_interfaces.textfsm, .*, cisco_ios, sh[[ow]] int[[erfaces]]
cisco_ios_show_interfaces_status.textfsm, .*, cisco_ios, sh[[ow]] int[[erfaces]] st[[atus]]
cisco_ios_show_ip_interface_brief.textfsm, .*, cisco_ios, sh[[ow]] ip int[[erface]] br[[ief]]
cisco_ios_show_version.textfsm, .*, cisco_ios, sh[[ow]] ver[[sion]]
cisco_ios_show_ip_route.textfsm, .*, cisco_ios, sh[[ow]] ip rou[[te]]
cisco_ios_show_ip_ospf_neighbor.textfsm, .*, cisco_ios, sh[[ow]] ip ospf nei[[ghbor]]
cisco_ios_show_ip_bgp_summary.textfsm, .*, cisco_ios, sh[[ow]] ip bgp sum[[mary]]
cisco_ios_show_processes_cpu.textfsm, .*, cisco_ios, sh[[ow]] proc[[esses]] cpu
cisco_ios_show_memory.textfsm, .*, cisco_ios, sh[[ow]] mem[[ory]]
cisco_ios_show_inventory.textfsm, .*, cisco_ios, sh[[ow]] inv[[entory]]

# Cisco IOS-XR Templates  
cisco_xr_show_interfaces.textfsm, .*, cisco_xr, sh[[ow]] int[[erfaces]]
cisco_xr_show_version.textfsm, .*, cisco_xr, sh[[ow]] ver[[sion]]

# Huawei VRP Templates
huawei_vrp_display_interface.textfsm, .*, huawei, dis[[play]] int[[erface]]
huawei_vrp_display_version.textfsm, .*, huawei, dis[[play]] ver[[sion]]

# Linux Templates
linux_ifconfig.textfsm, .*, linux, ifconfig
linux_ip_addr.textfsm, .*, linux, ip addr

# Generic Templates
generic_ping.textfsm, .*, .*, ping
