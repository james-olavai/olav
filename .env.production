# Production environment configuration for OLAV v2.0
# Copy this file to .env and fill in the required values
# WARNING: Do not commit .env to version control (add to .gitignore)

# ==============================================================================
# LLM Configuration (Required for full functionality)
# ==============================================================================

# OpenAI / Grok API Key
# Get from: https://platform.openai.com/api-keys or https://console.anthropic.com
LLM_API_KEY=sk-your-production-key-here

# LLM Model selection
# Options: gpt-4-turbo-preview, gpt-4, gpt-3.5-turbo, claude-3-opus, grok-beta
LLM_MODEL=gpt-4-turbo-preview

# LLM temperature (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.1

# LLM max tokens per request
LLM_MAX_TOKENS=4096

# ==============================================================================
# Network Device Configuration
# ==============================================================================

# Default credentials for network device access
NETWORK_USERNAME=admin
NETWORK_PASSWORD=your-production-password

# Network operation timeout (seconds)
NETWORK_TIMEOUT=60

# Parallel execution workers for multi-device operations
NETWORK_MAX_WORKERS=10

# SSH private key path (for key-based authentication)
# NETWORK_SSH_KEY=/path/to/ssh/key

# ==============================================================================
# Database Configuration
# ==============================================================================

# Database file paths (absolute paths recommended for production)
OLAV_DB_MAIN=/data/olav/databases/main.duckdb
OLAV_DB_AGENT=/data/olav/databases/agent.duckdb
OLAV_DB_CACHE=/data/olav/databases/llm_cache.db

# Database backup directory
OLAV_DB_BACKUP=/data/olav/backups

# Enable database WAL mode (Write-Ahead Logging) for better concurrency
OLAV_DB_WAL_MODE=true

# ==============================================================================
# Application Configuration
# ==============================================================================

# Environment type: development, staging, production
OLAV_ENV=production

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Application port for REST API
OLAV_API_PORT=8000

# Application host binding
OLAV_API_HOST=0.0.0.0

# Enable CORS for API (restrict in production)
OLAV_API_CORS_ORIGINS=https://your-domain.com

# ==============================================================================
# Feature Flags
# ==============================================================================

# Enable experimental features
ENABLE_EXPERIMENTAL=false

# Enable detailed performance logging
ENABLE_PERF_LOGGING=true

# Enable health check endpoint
ENABLE_HEALTH_CHECK=true

# ==============================================================================
# Caching Configuration
# ==============================================================================

# Cache backend: memory, redis, duckdb
CACHE_BACKEND=duckdb

# Cache TTL (Time-To-Live) in hours
CACHE_TTL_HOURS=24

# Enable semantic caching
ENABLE_SEMANTIC_CACHE=true

# ==============================================================================
# Clustering & High Availability (Optional)
# ==============================================================================

# Redis connection for clustering (optional)
# REDIS_URL=redis://redis-host:6379/0

# Enable clustering mode
# CLUSTER_MODE=false

# Node ID for clustering
# CLUSTER_NODE_ID=node-1

# ==============================================================================
# Monitoring & Observability
# ==============================================================================

# Sentry error tracking (optional)
# SENTRY_DSN=https://key@sentry.io/project-id

# Prometheus metrics enabled
ENABLE_METRICS=true

# Metrics port
METRICS_PORT=9090

# ==============================================================================
# Security
# ==============================================================================

# JWT secret for API authentication
OLAV_JWT_SECRET=your-very-long-random-secret-key-min-32-chars

# Enable API authentication
ENABLE_API_AUTH=true

# HTTPS/TLS enabled (set to true in production)
OLAV_TLS_ENABLED=false

# TLS certificate path (if enabled)
# OLAV_TLS_CERT=/etc/ssl/certs/olav.crt
# OLAV_TLS_KEY=/etc/ssl/private/olav.key

# ==============================================================================
# Backup & Recovery
# ==============================================================================

# Auto-backup enabled
enable_autobackup=true

# Backup schedule (cron format): every day at 2 AM
BACKUP_SCHEDULE=0 2 * * *

# Backup retention (days)
BACKUP_RETENTION_DAYS=30

# ==============================================================================
# Development/Debug Only (NOT for production)
# ==============================================================================

# Enable debug mode (set to false in production)
DEBUG=false

# Verbose output
VERBOSE=false

# Allow insecure connections (set to false in production)
ALLOW_INSECURE_SSL=false
