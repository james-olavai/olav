# Nornir Device Inventory — copy to hosts.yaml and update
#
# Each device needs: hostname (IP), platform, and group membership
# Credentials are in groups.yaml (use env vars, not plaintext)

R1:
  hostname: 10.0.0.1
  platform: cisco_ios
  groups:
    - core
    - cisco_ios

SW1:
  hostname: 10.0.0.10
  platform: cisco_ios
  groups:
    - access
    - cisco_ios
