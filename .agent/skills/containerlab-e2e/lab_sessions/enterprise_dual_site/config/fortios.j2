config system global
  set hostname {{ hostname }}
  set timezone UTC
  set admintimeout 30
  set admin-login-max 3
end

config system interface
  edit "port1"
    set vdom "root"
    set ip {{ mgmt_ip }} 255.255.255.0
    set status up
    set physical-name "port1"
  next
end

config system dns
  set primary 8.8.8.8
  set secondary 8.8.4.4
end

config system ntp
  set ntpsync enable
  set type server
  set server {{ ntp_server }}
end

config system syslog
  edit 1
    set server {{ syslog_server }}
    set mode udp
    set port 514
    set facility local0
  next
end

config system snmp community
  edit 1
    set name {{ snmp_community }}
    set status enable
    set events cpu-high mem-low log-full intf-ip vpn-tunnel
  next
end

config system snmp sysinfo
  set description "{{ hostname }} - OLAV Lab"
  set location "{{ site }}"
  set contact-info "OLAV Admin"
  set engine-id 800007E5
end

config system admin
  edit "admin"
    set password {{ password }}
    set accprofile "super_admin"
    set vdom "root"
  next
end

config system global
  set ssh-hostkey-type rsa2048
  set ssh-dss-key-size 1024
  set ssh-kex-alg diffie-hellman-group14 diffie-hellman-group1
  set ssh-enc-alg aes128-ctr aes192-ctr aes256-ctr aes128-cbc aes192-cbc aes256-cbc
  set ssh-mac-alg hmac-sha2-256 hmac-sha2-512 hmac-sha1
end

config system global
  set admin-sport 443
  set admin-ssh-port 22
end
