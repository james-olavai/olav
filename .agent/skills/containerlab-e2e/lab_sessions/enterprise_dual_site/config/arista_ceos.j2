!
! Arista cEOS 配置模板
!

no aaa root

interface Management0
   description Management Interface
   ip address {{ mgmt_ip }}/24
   no shut

ip route 0.0.0.0/0 192.168.100.254

ntp server {{ ntp_server }}

logging host {{ syslog_server }}
logging level ERRORS
logging level WARNINGS
logging level INFORMATIONAL

snmp-server community {{ snmp_community }}
snmp-server location "{{ site }}"
snmp-server contact "OLAV Admin"

ip name-server 8.8.8.8
ip name-server 8.8.4.4
hostname {{ hostname }}
!
dns domain {{ domain }}

username admin privilege 15 password {{ password }}

line vty 0 4
   transport input ssh
   exec timeout 0 0

line con 0
   exec timeout 0 0

management api http-commands
   protocol https
   no shutdown
   vrf management
      shutdown

management api gnmi
   transport grpc default
      vrf management

no ip address range

end
