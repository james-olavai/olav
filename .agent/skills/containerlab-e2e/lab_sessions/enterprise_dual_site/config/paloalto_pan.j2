<config version="11.0.0" urldb="paloaltonetworks">
  <mgt-config>
    <hostname>{{ hostname }}</hostname>
    <domain-name>{{ domain }}</domain-name>
    
    <!-- 管理网卡配置 -->
    <interface>
      <ethernet>
        <member name="ethernet1/1">
          <mode>static</mode>
          <ip-address>{{ mgmt_ip }}</ip-address>
          <netmask>255.255.255.0</netmask>
          <gateway>192.168.100.254</gateway>
        </member>
      </ethernet>
    </interface>
    
    <!-- NTP 配置 -->
    <ntp>
      <primary-ntp-server>{{ ntp_server }}</primary-ntp-server>
    </ntp>
    
    <!-- Syslog 配置 -->
    <syslog>
      <host>
        <name>{{ syslog_server }}</name>
        <facility>LOG_LOCAL0</facility>
        <priority>info</priority>
      </host>
    </syslog>
    
    <!-- SNMP 配置 -->
    <snmp>
      <version>2c</version>
      <community>
        <name>{{ snmp_community }}</name>
      </community>
      <sys-description>{{ hostname }} - OLAV Lab</sys-description>
      <sys-location>{{ site }}</sys-location>
      <sys-contact>OLAV Admin</sys-contact>
    </snmp>
    
    <!-- DNS 配置 -->
    <dns>
      <servers>
        <primary-dns>8.8.8.8</primary-dns>
        <secondary-dns>8.8.4.4</secondary-dns>
      </servers>
    </dns>
    
    <!-- 管理员用户配置 -->
    <users>
      <admin>
        <phash>{{ password }}</phash>
        <role>superuser</role>
      </admin>
    </users>
    
    <!-- SSH 配置 -->
    <ssh>
      <enable>yes</enable>
      <port>22</port>
      <ciphers>aes-128-cbc aes-192-cbc aes-256-cbc</ciphers>
    </ssh>
    
  </mgt-config>
  <devices>
    <!-- 默认安全策略 -->
  </devices>
</config>
