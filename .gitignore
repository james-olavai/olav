# OLAV Runtime & Data (Internal - Never Commit)
# Database files, caches, and runtime state that should never be version controlled
.olav/db/*.duckdb              # DuckDB database files (user/project specific)
.olav/db/*.duckdb-wal          # DuckDB WAL files
.olav/cache/                   # Runtime cache directory
.olav/logs/                    # Runtime logs
.olav/scratch/                 # Temporary working files
.olav/.last_thread_id          # Session state
.olav/.agent_memory.json       # Agent runtime memory
.olav/.cli_history             # CLI command history
*.sqlite                       # Any SQLite database files
*.db                           # Database files

# Platform Logs
logs/
*.log

# Exported Data (User-Facing, Version Controlled Optional)
# Uncomment to ignore exported data:
exports/snapshots/*
exports/reports/*
exports/visualizations/*
# Keep directory structure:
!exports/.gitkeep
!exports/snapshots/.gitkeep
!exports/reports/.gitkeep
!exports/reports/analysis/.gitkeep
!exports/reports/.gitkeep
!exports/visualizations/.gitkeep

# Sensitive Configuration (User-Specific - Never Commit)
# CRITICAL: These files contain API keys, passwords, network credentials, and secrets
# NEVER add these to version control - they are user-specific and sensitive
.env                           # Environment variables (API keys, secrets)
.env.local                     # Local environment overrides
.env.*.local                   # Environment-specific local overrides
.olav/settings.json            # User configuration with potential secrets
.olav/.agent_memory.json       # Agent internal state
.olav/.cli_history             # Command history with potentially sensitive commands
.olav/knowledge/aliases.md     # Device aliases (may contain sensitive info)
config/inventory.csv           # Device inventory (IP addresses, credentials)
.olav/config/nornir/hosts.yaml # Nornir configuration (device credentials, SSH keys)
config/nornir/hosts.yaml       # Device configuration with passwords

# User-specific knowledge (agent-generated)
.olav/knowledge/solutions/

# Build/Packaging
uv.lock

# Archives & Legacy (Excluded from Release)
archive/
docs

# Skill-specific duckdb files
.olav/skills/**/*.duckdb
.olav/skills/**/*.duckdb-wal
.olav/skills/**/*.duckdb-shm
