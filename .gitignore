# ══════════════════════════════════════════════════════════════════════════════
# OLAV Platform .gitignore
#
# Principle: ONLY platform source code and docs are tracked.
# Tests, scripts, dev_docs, netops workspaces, and all runtime data
# stay on disk for development but are NOT published.
# ══════════════════════════════════════════════════════════════════════════════

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.so
*.egg-info/
*.egg
dist/
build/
sdist/
wheels/
MANIFEST

# ── Virtual environments ─────────────────────────────────────────────────────
.venv/
venv/
env/

# ── IDEs & Editors ───────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ── Test & lint caches ───────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
.hypothesis/
.mypy_cache/
.pyright_cache/
.ruff_cache/
MagicMock/

# ── Build / Packaging ────────────────────────────────────────────────────────
uv.lock

# ── Non-release directories (on disk for development, NOT in release) ────────
tests/
scripts/
dev_docs/
dev_doc_archive/
docs/
mkdocs.yml
archive/
_legacy_archived/
site/
CHANGELOG.md
PARTNERS.md
.dockerignore

# ── AI tooling / IDE agent state ─────────────────────────────────────────────
.claude/
.github/
.sisyphus/
.agent/
.backup/
test-skill/

# ── Temporary / one-off scripts ──────────────────────────────────────────────
demo_*.py
parse_test.py
fix_openconfig_closure.py
test_playwright.py
test_watermark_integration.py
WATERMARK_IMPLEMENTATION_REPORT.md
TRAINING_DATA_*.md

# ── Platform Logs & Runtime ──────────────────────────────────────────────────
logs/
*.log
agent_outputs/
tmp/
run/

# ── Sub-repos and enterprise (co-located but separate projects) ──────────────
olav-netops/
olav-ent/
olav-doc/
src/olav/enterprise/

# ── Web / Node (web/ Astro site) ─────────────────────────────────────────────
node_modules/
web/node_modules/
web/dist/
web/.astro/
web/dist

# ── Exported data ────────────────────────────────────────────────────────────
exports/

# ── Sensitive files (NEVER commit) ──────────────────────────────────────────
.env
.env.local
.env.*.local
*.pypirc
.pypirc*
*.token
*.key
*.pem

# ══════════════════════════════════════════════════════════════════════════════
# .olav/ — Runtime directory (whitelist only platform-core content)
# ══════════════════════════════════════════════════════════════════════════════

# Default: ignore everything
.olav/*

# Whitelist: config examples only (real configs contain secrets)
!.olav/config/
.olav/config/*
!.olav/config/schemas/
!.olav/config/*.example

# Whitelist: only platform-core workspace agents
# All other workspaces (netops, test, experimental) are installed at runtime
# via `olav skill install` and stay on disk but are NOT in the release.
!.olav/workspace/
.olav/workspace/*
!.olav/workspace/config/
!.olav/workspace/core/
