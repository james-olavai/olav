# OLAV docker compose configuration — copy to `.env` and edit.
#
#   cp .env.docker.example .env
#
# Named .env.docker.example rather than .env.example because this repo's `.env`
# also carries development credentials; compose reads `.env` from the project
# directory, so the two share one file. Nothing here has a default that reaches
# a real endpoint — OLAV talks to whatever you point it at.

# ── LLM ───────────────────────────────────────────────────────────────────────
# Model, provider and endpoint live in .olav/config/api.json, written by
# `olav init` (run it once: `docker compose run --rm olav init`). Only the key
# belongs in the environment.
OLAV_LLM_API_KEY=

# Usable context per tier: small ≈8K / medium ≈32K / large ≥200K. This drives
# recall top_k and the execute_sql row cap, so over-stating it quietly overruns
# the window. `olav doctor` compares the budget against what the server
# advertises and flags the mismatch — that mismatch is what surfaces as
# "agent error, code 400" on a long run.
OLAV_LLM_MODEL_TIER=medium
# Override the tier's default budget only if you know the served window.
OLAV_LLM_CONTEXT_BUDGET=

# ── Embeddings ────────────────────────────────────────────────────────────────
# `api` calls an endpoint; `local` runs sentence-transformers in process and
# needs the [local-embed] extra, which the image does not install.
OLAV_EMBEDDING_MODE=api
OLAV_EMBEDDING_BASE_URL=
OLAV_EMBEDDING_MODEL=
OLAV_EMBEDDING_API_KEY=

# Some servers reject long inputs instead of truncating them — a 512-token
# ubatch returns HTTP 500 past roughly 1000 characters. Raise this only together
# with the server's batch size, never on its own.
OLAV_EMBED_MAX_CHARS=

# ── Auth ──────────────────────────────────────────────────────────────────────
# `none` treats the local OS user as admin, which is what a single-operator
# install wants. `token` requires olav-ent: it ships the token provider, and
# without it `init` and `doctor` both pass while every query fails.
OLAV_AUTH_MODE=none

# ── netops profile only ───────────────────────────────────────────────────────
# Credentials for reaching lab or production devices over SSH. CLAB_USERNAME is
# the name the rest of the system uses, so it is the name used here.
CLAB_USERNAME=
CLAB_PASSWORD=

# Directory mounted read-only at /home/olav/.ssh for key-based device access.
# Leave as-is if you authenticate with a password.
SSH_KEY_DIR=./.ssh-empty

# Host port mappings, in case something already holds these.
BATFISH_PORT_9996=9996
BATFISH_PORT_9997=9997
BATFISH_PORT_8888=8888
