---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const terminalLines = [
  { prompt: true, text: 'olav "how many devices are online?"' },
  { prompt: false, text: '→ Querying topology... 47 devices online, 2 unreachable' },
  { prompt: true, text: 'olav "which BGP neighbors are down on core-router-01?"' },
  { prompt: false, text: '→ BGP neighbor 10.0.0.2 (AS 65001) — Idle since 14:32 UTC' },
  { prompt: true, text: 'olav registry register http://netbox.corp/api/schema/' },
  { prompt: false, text: '→ ✓ Registered NetBox — 312 tools available immediately' },
];

const features = [
  {
    icon: '⚡',
    title: 'Any API → Agent Tool',
    desc: 'Register an OpenAPI service once. Query it in natural language forever. No code, no MCP servers.',
  },
  {
    icon: '🔒',
    title: 'Four-Layer Execution Governance',
    desc: 'AAA auth → HITL interception → DuckDB read-only sandbox → credential auto-redaction. Hard constraints cannot be bypassed.',
  },
  {
    icon: '🧠',
    title: 'Self-Improving Loop',
    desc: 'Every tool call and error is captured. Failure patterns become constraints. Agents get better over time — automatically.',
  },
  {
    icon: '🚀',
    title: '2000x+ Cache Speedup',
    desc: 'Semantic + exact cache layers. Repeated queries return instantly. LLM tokens spent only when truly needed.',
  },
  {
    icon: '🏗️',
    title: 'Creator Agent',
    desc: '6-step workflow. Deploy a new Skill from any OpenAPI schema in under 2 minutes. No framework knowledge required.',
  },
  {
    icon: '👥',
    title: 'Multi-User & Audit',
    desc: 'Concurrent users, isolated sessions. Every CLI command recorded to DuckDB audit trail. LDAP/OIDC ready.',
  },
];
---

<Layout title="OLAV — AI-Native Infrastructure Operations Platform">
  <Header />

  <!-- Hero -->
  <main>
    <section class="relative min-h-screen flex items-center pt-20">
      <!-- Background glow -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[800px] h-[600px] bg-brand-600/10 rounded-full blur-3xl"></div>
      </div>

      <div class="mx-auto max-w-7xl px-6 py-24 relative z-10">
        <div class="mx-auto max-w-3xl text-center">
          <div class="inline-flex items-center gap-2 rounded-full border border-brand-500/30 bg-brand-500/10 px-4 py-1.5 text-sm text-brand-400 mb-8">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-400 animate-pulse"></span>
            v0.10.0 — Now Open Source
          </div>

          <h1 class="text-5xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white leading-tight">
            Control infrastructure
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-400 to-violet-400">
              with natural language
            </span>
          </h1>

          <p class="mt-6 text-xl text-gray-400 leading-relaxed max-w-2xl mx-auto">
            Connect any API, deploy specialized AI agents, orchestrate operational workflows —
            without writing SQL or memorizing CLI flags.
          </p>

          <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href="https://docs.olavai.com/getting-started/installation"
              class="rounded-lg bg-brand-600 px-8 py-3.5 text-base font-semibold text-white shadow-lg hover:bg-brand-500 transition-colors"
            >
              Get Started Free →
            </a>
            <a
              href="https://github.com/james-olavai/olav"
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-lg border border-white/10 bg-white/5 px-8 py-3.5 text-base font-semibold text-white hover:bg-white/10 transition-colors flex items-center gap-2 justify-center"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
              </svg>
              View on GitHub
            </a>
          </div>
        </div>

        <!-- Terminal demo -->
        <div class="mt-20 mx-auto max-w-3xl">
          <div class="rounded-xl border border-white/10 bg-gray-900/80 backdrop-blur shadow-2xl overflow-hidden">
            <!-- Window chrome -->
            <div class="flex items-center gap-2 px-4 py-3 border-b border-white/5 bg-gray-900">
              <span class="w-3 h-3 rounded-full bg-red-500/80"></span>
              <span class="w-3 h-3 rounded-full bg-yellow-500/80"></span>
              <span class="w-3 h-3 rounded-full bg-green-500/80"></span>
              <span class="ml-3 text-xs text-gray-500 font-mono">olav — bash</span>
            </div>
            <div class="p-6 font-mono text-sm space-y-2 overflow-x-auto">
              {terminalLines.map((line) => (
                <div class={line.prompt ? 'flex gap-2' : 'pl-4'}>
                  {line.prompt && <span class="text-brand-400 select-none">$</span>}
                  <span class={line.prompt ? 'text-white' : 'text-gray-400'}>{line.text}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Feature grid -->
    <section class="py-24 border-t border-white/5">
      <div class="mx-auto max-w-7xl px-6">
        <div class="text-center mb-16">
          <h2 class="text-3xl sm:text-4xl font-bold text-white">Built for production operations</h2>
          <p class="mt-4 text-gray-400 text-lg">
            Not another chatbot. A governed, audited, self-improving operations platform.
          </p>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {features.map((f) => (
            <div class="rounded-xl border border-white/5 bg-gray-900/50 p-6 hover:border-brand-500/30 hover:bg-gray-900 transition-all">
              <div class="text-3xl mb-4">{f.icon}</div>
              <h3 class="text-base font-semibold text-white mb-2">{f.title}</h3>
              <p class="text-sm text-gray-400 leading-relaxed">{f.desc}</p>
            </div>
          ))}
        </div>
        <div class="mt-12 text-center">
          <a href="/features" class="text-brand-400 hover:text-brand-300 font-medium text-sm transition-colors">
            See all features →
          </a>
        </div>
      </div>
    </section>

    <!-- Architecture layer callout -->
    <section class="py-24 border-t border-white/5">
      <div class="mx-auto max-w-7xl px-6">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <h2 class="text-3xl sm:text-4xl font-bold text-white leading-tight">
              Enterprise-grade governance.<br/>
              <span class="text-gray-400">Not optional.</span>
            </h2>
            <p class="mt-6 text-gray-400 leading-relaxed">
              Every agent decision passes through four mandatory control layers.
              DuckDB read-only enforcement is a hard constraint — no configuration disables it.
            </p>
            <a
              href="/features#security"
              class="mt-8 inline-flex items-center gap-2 text-brand-400 hover:text-brand-300 font-medium text-sm transition-colors"
            >
              Security architecture →
            </a>
          </div>
          <div class="rounded-xl border border-white/5 bg-gray-900/50 p-6 font-mono text-sm space-y-3">
            {[
              { layer: 'Layer 0', label: 'AAA', desc: 'Token / LDAP / OIDC auth → RBAC → audit trail', color: 'text-red-400' },
              { layer: 'Layer 1', label: 'Middleware', desc: 'HITL dangerous-command interception + memory injection', color: 'text-yellow-400' },
              { layer: 'Layer 2', label: 'Sandbox', desc: 'Pre-scan → DuckDB read-only → network namespace isolation', color: 'text-green-400' },
              { layer: 'Layer 3', label: 'Output', desc: 'Credential auto-redaction + SSE JSON + HttpOnly cookies', color: 'text-blue-400' },
            ].map((l) => (
              <div class="flex gap-4">
                <div class="shrink-0">
                  <span class={`text-xs font-semibold ${l.color}`}>{l.layer}</span>
                  <div class="text-white font-semibold text-xs mt-0.5">{l.label}</div>
                </div>
                <div class="text-gray-400 text-xs leading-relaxed border-l border-white/5 pl-4">{l.desc}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-24 border-t border-white/5">
      <div class="mx-auto max-w-3xl px-6 text-center">
        <h2 class="text-3xl sm:text-4xl font-bold text-white">Ready to automate your ops?</h2>
        <p class="mt-4 text-gray-400 text-lg">
          Open source. Self-hosted. Enterprise extensions available.
        </p>
        <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="https://docs.olavai.com/getting-started/installation"
            class="rounded-lg bg-brand-600 px-8 py-3.5 text-base font-semibold text-white hover:bg-brand-500 transition-colors"
          >
            Read the docs →
          </a>
          <a
            href="/pricing"
            class="rounded-lg border border-white/10 bg-white/5 px-8 py-3.5 text-base font-semibold text-white hover:bg-white/10 transition-colors"
          >
            View pricing
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
