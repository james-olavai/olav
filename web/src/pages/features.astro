---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const sections = [
  {
    id: 'api-as-tool',
    emoji: '⚡',
    title: 'API-as-Tool',
    subtitle: 'Any API becomes an agent tool in one command',
    desc: 'No code. No MCP servers. Register an OpenAPI service once, query it in natural language forever. The Creator Agent can also generate editable Python @tool functions from any OpenAPI schema for deep customization.',
    code: `olav registry register http://netbox.corp/api/schema/
# → ✓ Registered NetBox — 312 tools available immediately

olav "how many devices are in rack A1?"
# → 14 devices (8 active, 6 planned)`,
  },
  {
    id: 'security',
    emoji: '🔒',
    title: 'Four-Layer Execution Governance',
    subtitle: 'Hard constraints that cannot be bypassed',
    desc: 'Every agent decision passes through AAA authentication, HITL command interception, DuckDB read-only enforcement, and output credential redaction. Soft constraints are configurable — hard constraints are not.',
    code: `Layer 0: AAA
  Token / LDAP / OIDC auth → RBAC → full audit trail

Layer 1: Middleware
  HITL dangerous-command interception
  Memory injection from LanceDB

Layer 2: Sandbox
  Pre-scan → DuckDB read-only enforcement
  Network namespace isolation

Layer 3: Output
  Credential auto-redaction
  SSE JSON encoding + HttpOnly cookies`,
  },
  {
    id: 'self-improving',
    emoji: '🧠',
    title: 'Self-Improving Loop',
    subtitle: 'Agents get better over time — automatically',
    desc: 'Every tool call and error is captured in the audit log. The trace-review workflow extracts failure constraints and writes them to LanceDB memory. Future runs recall those constraints before acting.',
    code: `Use OLAV → audit log captures every tool call + error
    ↓
/trace-review extracts failure constraints
    ↓
Writes to LanceDB memory
    ↓
Future runs recall constraints before acting
    ↓
Known pitfalls avoided automatically`,
  },
  {
    id: 'creator',
    emoji: '🏗️',
    title: 'Creator Agent',
    subtitle: 'Deploy a new Skill in under 2 minutes',
    desc: 'Six-step automated workflow: discover OpenAPI schema → generate Python tools → validate → register → deploy. Supports both top-level agents and subskills under existing agents.',
    code: `olav --agent config "create a skill for my Prometheus server"
# Step 1: Discover schema at /metrics, /api/v1/query
# Step 2: Generate 8 @tool functions
# Step 3: Validate function signatures
# Step 4: Register under ops agent
# ✓ Skill deployed → .olav/workspace/ops/prometheus/`,
  },
  {
    id: 'cache',
    emoji: '🚀',
    title: 'Multi-Layer Cache',
    subtitle: 'Measured 2000x+ speedup on repeated queries',
    desc: 'Semantic similarity cache + exact match cache. LLM tokens are spent only when the query is genuinely novel. Snapshot-aware invalidation ensures stale data is never served.',
    code: `olav "how many BGP sessions are established?"
# Cache HIT (exact) — 0ms ⚡

olav "how many BGP neighbors are up?"
# Cache HIT (semantic, 0.97 similarity) — 12ms ⚡

olav "BGP sessions established after last snapshot?"
# Cache MISS (snapshot boundary) — LLM invoked`,
  },
  {
    id: 'multiuser',
    emoji: '👥',
    title: 'Multi-User & Full Audit',
    subtitle: 'Concurrent users, isolated sessions, complete audit trail',
    desc: 'LangGraph checkpoints and LLM cache are user-local (~/.olav/). Shared DuckDB state is read-only for agents. Every CLI command is recorded to a centralized audit.duckdb. LDAP and OIDC authentication supported.',
    code: `# All sessions isolated in ~/.olav/sessions/<user>/
# Every command recorded in .olav/databases/audit.duckdb

olav admin users list
# alice   ops-team    2026-04-01 14:32
# bob     read-only   2026-04-01 09:11

olav log export --format json --since 7d > audit.json`,
  },
];
---

<Layout
  title="Features — OLAV Platform"
  description="API-as-Tool, four-layer governance, self-improving agents, Creator Agent, multi-layer cache, and full audit trail."
>
  <Header />

  <main class="pt-28">
    <div class="mx-auto max-w-7xl px-6 pb-24">
      <!-- Page header -->
      <div class="mx-auto max-w-2xl text-center mb-20">
        <h1 class="text-4xl sm:text-5xl font-extrabold text-white">Features</h1>
        <p class="mt-4 text-xl text-gray-400 leading-relaxed">
          Every capability is verified against real infrastructure. No marketing claims without passing E2E tests.
        </p>
      </div>

      <!-- Feature sections -->
      <div class="space-y-24">
        {sections.map((s, i) => (
          <div id={s.id} class={`grid lg:grid-cols-2 gap-12 items-center ${i % 2 === 1 ? 'lg:grid-flow-col-dense' : ''}`}>
            <div class={i % 2 === 1 ? 'lg:col-start-2' : ''}>
              <div class="text-4xl mb-4">{s.emoji}</div>
              <h2 class="text-2xl sm:text-3xl font-bold text-white">{s.title}</h2>
              <p class="mt-1 text-brand-400 font-medium">{s.subtitle}</p>
              <p class="mt-4 text-gray-400 leading-relaxed">{s.desc}</p>
            </div>
            <div class={i % 2 === 1 ? 'lg:col-start-1 lg:row-start-1' : ''}>
              <div class="rounded-xl border border-white/10 bg-gray-900 overflow-hidden">
                <div class="flex items-center gap-2 px-4 py-3 border-b border-white/5 bg-gray-900/50">
                  <span class="w-2.5 h-2.5 rounded-full bg-red-500/60"></span>
                  <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/60"></span>
                  <span class="w-2.5 h-2.5 rounded-full bg-green-500/60"></span>
                </div>
                <pre class="p-6 font-mono text-sm text-gray-300 overflow-x-auto leading-relaxed whitespace-pre-wrap">{s.code}</pre>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Bottom CTA -->
      <div class="mt-24 rounded-2xl border border-brand-500/20 bg-brand-500/5 p-12 text-center">
        <h2 class="text-2xl font-bold text-white">Start in 5 minutes</h2>
        <p class="mt-3 text-gray-400">pip install olav — self-hosted, no cloud dependency</p>
        <a
          href="https://docs.olavplatform.com/getting-started/installation"
          class="mt-8 inline-block rounded-lg bg-brand-600 px-8 py-3.5 text-base font-semibold text-white hover:bg-brand-500 transition-colors"
        >
          Installation guide →
        </a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
