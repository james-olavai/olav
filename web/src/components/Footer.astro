---
---

<footer class="border-t border-white/5 bg-gray-950 py-12">
  <div class="mx-auto max-w-7xl px-6">
    <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
      <div class="col-span-2 md:col-span-1">
        <a href="/" class="flex items-center gap-2 font-bold text-lg">
          <span class="text-brand-500">◈</span>
          <span class="text-white">OLAV</span>
        </a>
        <p class="mt-3 text-sm text-gray-400 leading-relaxed">
          Enterprise AI-native platform for autonomous infrastructure operations.
        </p>
        <p class="mt-4 text-xs text-gray-600">BSL-1.1 License</p>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-white">Product</h3>
        <ul class="mt-4 space-y-2 text-sm text-gray-400">
          <li><a href="/features" class="hover:text-white transition-colors">Features</a></li>
          <li><a href="/pricing" class="hover:text-white transition-colors">Pricing</a></li>
          <li><a href="/changelog" class="hover:text-white transition-colors">Changelog</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-white">Developers</h3>
        <ul class="mt-4 space-y-2 text-sm text-gray-400">
          <li>
            <a
              href="https://docs.olavai.com"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-white transition-colors"
            >
              Documentation
            </a>
          </li>
          <li>
            <a
              href="https://github.com/james-olavai/olav"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-white transition-colors"
            >
              GitHub
            </a>
          </li>
          <li>
            <a
              href="https://docs.olavai.com/reference/http-api"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-white transition-colors"
            >
              HTTP API
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-white">Company</h3>
        <ul class="mt-4 space-y-2 text-sm text-gray-400">
          <li><a href="mailto:hello@olavai.com" class="hover:text-white transition-colors">Contact</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-10 border-t border-white/5 pt-8 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-xs text-gray-600">
        © {new Date().getFullYear()} OLAV Platform. All rights reserved.
      </p>
      <p class="text-xs text-gray-600">
        Built with ❤️ for network engineers
      </p>
    </div>
  </div>
</footer>
